    {"name": "Pivot-Zeilensumme: ohne DAZ", "query": "x.digital_access_zone=", "expect": ["A-10"], "canonical": "x.digital_access_zone="},
    {"name": "Pivot-Spaltensumme: (leer)", "query": "f.affected=leer", "expect": ["A-2"], "canonical": "f.affected=leer"},
