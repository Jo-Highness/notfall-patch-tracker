    {"name": "unbekanntes Sortierfeld ignoriert (dir wirkt nicht)", "query": "sort=foo&dir=desc", "expect": ["A-1", "A-10", "A-2", "A-3", "B-1", "NEW-0001"], "canonical": ""},
    {"name": "Suche + Sortierung", "query": "q=firma&f.cio_unit=zentral&sort=sbf&dir=desc", "expect": ["B-1", "A-3", "A-1"], "canonical": "q=firma&f.cio_unit=zentral&sort=sbf&dir=desc"},
