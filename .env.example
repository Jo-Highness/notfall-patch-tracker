# Notfall-Patch-Tracker – Beispielkonfiguration. Kopieren nach .env und anpassen.
# .env NIE committen. Im Betrieb Geheimnisse besser aus einem eigenen Secret-Store einspielen.

# ---------------------------------------------------------------- Geheimnisse (Pflicht)
# Datenbank-Passwort (beliebig lang, zufaellig: openssl rand -base64 32)
POSTGRES_PASSWORD=
# HMAC-Schluessel fuer CSRF-Token, mind. 32 Zeichen (openssl rand -hex 32)
CSRF_SECRET=

# ---------------------------------------------------------------- Datenbank
POSTGRES_DB=npt
POSTGRES_USER=npt
# DATABASE_URL (vollstaendige URL, ueberschreibt POSTGRES_*) gilt NUR beim Betrieb ohne
# diese Compose-Datei (z. B. externe DB, eigener Orchestrator). docker-compose.yml reicht
# sie bewusst nicht an die App durch – dort zaehlen immer POSTGRES_* und der db-Dienst.
POSTGRES_MAX_CONNECTIONS=200

# ---------------------------------------------------------------- Ports / Netz
# Bearbeiter-Port der App auf dem Host. Default nur loopback (Reverse Proxy davor).
PUBLIC_BIND_ADDR=127.0.0.1
PUBLIC_PORT=8080
# mTLS-Port des admin-gateway auf dem Host.
GATEWAY_BIND_ADDR=0.0.0.0
GATEWAY_PORT=8443
# Internes Admin-Netz (feste Adressen; nur bei Kollision mit vorhandenen Netzen aendern).
ADMIN_NET_SUBNET=172.31.250.0/28
APP_ADMIN_IP=172.31.250.10
GATEWAY_ADMIN_IP=172.31.250.11
# Reverse Proxies vor dem Bearbeiter-Port, deren X-Forwarded-For ausgewertet wird
# (kommagetrennte IPs/CIDRs, leer = keinem Proxy vertrauen).
TRUSTED_PROXY_IPS=
# Optionales HTTPS-Overlay docker-compose.tls.yml (DECISIONS J14): COMPOSE_FILE ergaenzen,
# PUBLIC_BASE_URL auf https://<host>:<PUBLIC_TLS_PORT> setzen; TRUSTED_PROXY_IPS setzt das Overlay.
#PUBLIC_TLS_DIR=/pfad/zu/zertifikat        # fullchain.pem + server.key (nicht im Repo)
#PUBLIC_TLS_BIND_ADDR=0.0.0.0
#PUBLIC_TLS_PORT=8444
#PUBLIC_TLS_HTTP_BIND_ADDR=0.0.0.0         # Zusatzport, leitet auf PUBLIC_TLS_PORT um
#PUBLIC_TLS_HTTP_PORT=8081
#TLS_NET_SUBNET=172.31.250.16/28           # APP_TLS_IP .18, PUBLIC_TLS_PROXY_IP .19

# ---------------------------------------------------------------- URLs
# Oeffentliche Basis-URL fuer Projekt-Links und Mail-Deep-Links.
PUBLIC_BASE_URL=http://localhost:8080
# Basis-URL des Admin-Bereichs (fuer die Origin-Pruefung, CSRF). Leer = aus Host-Header des Gateways.
ADMIN_BASE_URL=https://localhost:8443

# ---------------------------------------------------------------- Admin-Zugang (mTLS)
# Host-Verzeichnis mit ca-bundle.pem, server.crt, server.key und optional crl.pem.
# Test-PKI: scripts/gen-test-pki.sh erzeugt ./pki-out/gateway. Produktion: absoluter Pfad.
ADMIN_PKI_DIR=./pki-out/gateway
# Pfade IM Gateway-Container (Mount-Ziel /etc/npt-gateway/pki).
ADMIN_CA_BUNDLE_PATH=/etc/npt-gateway/pki/ca-bundle.pem
GATEWAY_TLS_CERT_PATH=/etc/npt-gateway/pki/server.crt
GATEWAY_TLS_KEY_PATH=/etc/npt-gateway/pki/server.key
# Optional: CRL (PEM). Leer = keine CRL-Pruefung. Aenderungen werden ohne Neustart geladen.
ADMIN_CRL_PATH=
CRL_RELOAD_INTERVAL=60
# Maximale Kettentiefe bei der Client-Zertifikatspruefung.
ADMIN_VERIFY_DEPTH=2
# Woran Admins erkannt werden: subject_dn | san_email | san_upn | fingerprint_sha256
ADMIN_CERT_ID_ATTRIBUTE=subject_dn
# Initiale Admins (Liste mit ';' getrennt oder JSON-Liste). Optional mit Aussteller: "<Issuer-DN>::<Identifier>".
# Beispiel: ADMIN_BOOTSTRAP_IDS=CN=Max Muster,OU=IT,O=Firma,C=DE
ADMIN_BOOTSTRAP_IDS=

# ---------------------------------------------------------------- Prozesse / Betrieb
# all | public | admin | jobs
APP_ROLE=all
# Bearbeiter-Worker: je Worker 300 SSE-Streams, ca. 18 DB-Verbindungen, ca. 90 MB RAM.
# Sizing-Tabelle: docs/INSTALLATION.md (Abschnitt Kapazitaet).
WEB_WORKERS=6
ADMIN_WORKERS=2
LOG_LEVEL=INFO
DISPLAY_TZ=Europe/Berlin
APP_MEM_LIMIT=1536m
DB_MEM_LIMIT=1g
GATEWAY_MEM_LIMIT=128m
NPT_IMAGE_TAG=latest

# ---------------------------------------------------------------- Grenzen (Defaults laut Auftrag)
RATE_LIMIT_WRITES=30
RATE_LIMIT_WRITES_WINDOW_S=10
RATE_LIMIT_CREATE=10
RATE_LIMIT_CREATE_WINDOW_S=60
UPLOAD_MAX_MB=20

# ---------------------------------------------------------------- SMTP (Mailversand, Auftrag 6.3)
# Leer = Versand deaktiviert (Kampagnen lassen sich anlegen und pruefen, aber nicht senden).
# Dev/Test: Overlay docker-compose.mailpit.yml (lokaler Test-SMTP, stellt nichts zu), z. B.
#   COMPOSE_FILE=docker-compose.yml:docker-compose.mailpit.yml
SMTP_HOST=
# 587 (starttls), 465 (tls), 25 (none, nur interne Relays)
SMTP_PORT=587
# starttls = STARTTLS erzwungen | tls = implizites TLS | none = unverschluesselt
SMTP_SECURITY=starttls
# Leer = ohne Anmeldung
SMTP_USER=
SMTP_PASSWORD=
# Absender (Pflicht fuer den Versand), z. B. "Notfall-Patch-Tracker <npt@firma.de>"
SMTP_FROM=
# Optional: Antwortadresse, z. B. das Security-Postfach
SMTP_REPLY_TO=
# Zeitlimit je SMTP-Verbindung/Befehl in Sekunden
SMTP_TIMEOUT_S=30
# Drosselung: Mails je Sekunde (ein Sender, Abstand 1/Rate)
MAIL_RATE_PER_SEC=5

# ---------------------------------------------------------------- Stammdaten-API (Stub, deaktiviert)
MASTER_API_ENABLED=false
MASTER_API_URL=
MASTER_API_TOKEN=
MASTER_API_SCHEDULE_MINUTES=0
